# ============================================================
# Living-Kingdom bot — environment variables
# Copy this file to .env and fill in your values.
# .env is never committed to git.
# ============================================================

# ------------------------------------------------------------
# Kalshi credentials
#
# Demo and live are SEPARATE Kalshi accounts with separate keys.
# Demo account:  https://demo.kalshi.co  → Settings → API Keys
# Live account:  https://kalshi.com      → Settings → API Keys
#
# After creating an API key, download the RSA private key (.pem).
# Store it somewhere safe (e.g. keys/kalshi_demo.pem) and set
# the path below.  Never commit .pem files to git.
# ------------------------------------------------------------

# Demo credentials (used when USE_DEMO = True in config.py)
KALSHI_DEMO_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
KALSHI_DEMO_PRIVATE_KEY_PATH=keys/kalshi_demo.pem

# Live credentials (used when USE_DEMO = False in config.py)
KALSHI_LIVE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
KALSHI_LIVE_PRIVATE_KEY_PATH=keys/kalshi_live.pem

# ------------------------------------------------------------
# NOAA Climate Data Online token
# Register at: https://www.ncdc.noaa.gov/cdo-web/token
# ------------------------------------------------------------
NOAA_CDO_TOKEN=your_noaa_token_here

# ------------------------------------------------------------
# Google Sheets integration (optional — for trade log / dashboard)
# GOOGLE_SHEET_ID: the long ID from your Sheet's URL
# GOOGLE_CREDENTIALS_JSON: path to service account key JSON
# ------------------------------------------------------------
GOOGLE_SHEET_ID=your_sheet_id_here
GOOGLE_CREDENTIALS_JSON=keys/google_service_account.json
